{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "claim_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "statement",
        "source_id",
        "printed_page",
        "observation_unit",
        "assumptions",
        "alternative_explanation",
        "evidence",
        "limitations",
        "worker_verdict",
        "main_agent_disposition"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "observation_unit": {
          "type": "string",
          "minLength": 1
        },
        "alternative_explanation": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "limitations": {
          "type": "string",
          "minLength": 1
        },
        "printed_page": {
          "type": [
            "string",
            "null"
          ]
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "worker_verdict": {
          "enum": [
            "supports",
            "contradicts",
            "unresolved",
            "not_checked"
          ]
        },
        "main_agent_disposition": {
          "enum": [
            "pending",
            "accepted_as_attributed",
            "qualified",
            "rejected",
            "unresolved"
          ]
        }
      }
    },
    "experiment_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "experiment",
        "scenario_id",
        "protocol_version",
        "input_hashes",
        "source_version",
        "membership",
        "complete",
        "method",
        "result_scope",
        "outcome",
        "output_path",
        "review_status"
      ],
      "properties": {
        "experiment": {
          "type": "string",
          "minLength": 1
        },
        "scenario_id": {
          "type": "string",
          "minLength": 1
        },
        "protocol_version": {
          "type": "string",
          "minLength": 1
        },
        "source_version": {
          "type": "string",
          "minLength": 1
        },
        "membership": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "output_path": {
          "type": "string",
          "minLength": 1
        },
        "input_hashes": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "complete": {
          "type": "boolean"
        },
        "result_scope": {
          "enum": [
            "nominal",
            "finite_grid",
            "continuous_enclosure",
            "source_interpretation"
          ]
        },
        "outcome": {
          "enum": [
            "supports_within_scope",
            "counterexample",
            "inconclusive",
            "uncomputable"
          ]
        },
        "review_status": {
          "enum": [
            "pending",
            "accepted",
            "revise",
            "rejected"
          ]
        }
      }
    }
  }
}
